# ==================================================
# ISSA MONOREPO
# Root .gitignore for client/ and server/
# ==================================================

# Dependencies
**/node_modules/
**/.pnp
**/.pnp.*

# Yarn
**/.yarn/*
!**/.yarn/patches/
!**/.yarn/plugins/
!**/.yarn/releases/
!**/.yarn/versions/

# Testing
**/coverage/
**/.nyc_output/
**/junit.xml

# Next.js
**/.next/
**/out/

# Build outputs
**/build/
**/dist/

# Caches
**/.cache/
**/.parcel-cache/
**/.eslintcache
**/*.tsbuildinfo

# Environment files and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.example.*
!**/.env.example.txt

# Vercel
**/.vercel/

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime files
**/*.pid
**/*.pid.lock
**/pids/

# Local database/storage files
**/*.sqlite
**/*.sqlite3
**/*.db

# Certificates and private keys
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Operating system files
.DS_Store
**/.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
**/tmp/
**/temp/

# Local tooling
.claude/worktrees/
.codex/