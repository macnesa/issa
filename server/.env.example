NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://issa_user:replace-with-password@db.example.com:5432/issa
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-value
FRONTEND_ORIGINS=https://parent.example.com,https://teacher.example.com
ALLOW_REMOTE_DEMO_BOOTSTRAP=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AI_NARRATIVE_ENABLED=true
AI_NARRATIVE_PROVIDER=groq
AI_NARRATIVE_API_KEY=
AI_NARRATIVE_BASE_URL=https://api.groq.com/openai/v1
AI_NARRATIVE_MODEL=openai/gpt-oss-120b
AI_NARRATIVE_TIMEOUT_MS=20000

# Local development PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=issa_project_dev
DB_USER=issa_dev
DB_PASSWORD=replace-with-local-password

# Optional isolated test database
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_NAME=issa_project_test
TEST_DB_USER=issa_test
TEST_DB_PASSWORD=replace-with-test-password
