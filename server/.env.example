# Copy this file to .env for local development.
# Never commit real passwords, API keys, tokens, or production URLs.

# -----------------------------------------------------------------------------
# Local server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_TIMEZONE=Asia/Jakarta

# -----------------------------------------------------------------------------
# Local PostgreSQL
# Used when NODE_ENV is development.
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=issa_project_dev
DB_USER=issa_dev
DB_PASSWORD=replace-with-local-password

# -----------------------------------------------------------------------------
# Isolated test PostgreSQL
# TEST_DB_NAME is required by the backend test suite and must differ from DB_NAME.
# Host, port, user, and password fall back to the local DB values when left empty.
# -----------------------------------------------------------------------------
TEST_DB_HOST=
TEST_DB_PORT=
TEST_DB_NAME=issa_project_test
TEST_DB_USER=
TEST_DB_PASSWORD=

# -----------------------------------------------------------------------------
# Authentication
# Generate a long random value. Never expose it to Parent or CMS.
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-value

# -----------------------------------------------------------------------------
# Public read-only demo
# IDs are selected only on the server and must point to synthetic demo actors.
# -----------------------------------------------------------------------------
PUBLIC_DEMO_ENABLED=true
DEMO_TEACHER_ID=
DEMO_PARENT_ID=

# Optional in-memory limits per server instance.
PUBLIC_DEMO_LOGIN_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_DEMO_LOGIN_RATE_LIMIT_MAX=30
PUBLIC_DEMO_AI_RATE_LIMIT_WINDOW_MS=600000
PUBLIC_DEMO_AI_RATE_LIMIT_MAX=5

# -----------------------------------------------------------------------------
# AI narrative draft generation
# -----------------------------------------------------------------------------
AI_NARRATIVE_ENABLED=true
AI_NARRATIVE_PROVIDER=groq
AI_NARRATIVE_API_KEY=
AI_NARRATIVE_BASE_URL=https://api.groq.com/openai/v1
AI_NARRATIVE_MODEL=openai/gpt-oss-120b
AI_NARRATIVE_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# Cloudinary evidence uploads
# Required for normal Teacher uploads; demo sessions remain read-only.
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Production hosting only
# Configure these in the hosting provider, not in a committed file.
# DATABASE_URL must identify the managed PostgreSQL database.
# FRONTEND_ORIGINS must contain exact Parent and CMS HTTPS origins, comma-separated.
# Keep ALLOW_REMOTE_DEMO_BOOTSTRAP=false except during an approved empty-DB bootstrap.
# -----------------------------------------------------------------------------
DATABASE_URL=
DATABASE_SSL=true
FRONTEND_ORIGINS=
ALLOW_REMOTE_DEMO_BOOTSTRAP=false
